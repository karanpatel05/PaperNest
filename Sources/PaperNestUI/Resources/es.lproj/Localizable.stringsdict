<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>item.pageCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@pages@</string>
		<key>pages</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld página</string>
			<key>many</key>
			<string>%lld páginas</string>
			<key>other</key>
			<string>%lld páginas</string>
		</dict>
	</dict>
	<key>library.itemCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld elemento</string>
			<key>many</key>
			<string>%lld elementos</string>
			<key>other</key>
			<string>%lld elementos</string>
		</dict>
	</dict>
	<key>ink.strokeCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@strokes@</string>
		<key>strokes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld trazo</string>
			<key>many</key>
			<string>%lld trazos</string>
			<key>other</key>
			<string>%lld trazos</string>
		</dict>
	</dict>
	<key>ink.selectionCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@selected@</string>
		<key>selected</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld trazo seleccionado</string>
			<key>many</key>
			<string>%lld trazos seleccionados</string>
			<key>other</key>
			<string>%lld trazos seleccionados</string>
		</dict>
	</dict>
</dict>
</plist>
