<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox with access only to files the user picks or drops. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!--
	iCloud sync needs a provisioning profile, so its entitlements live in
	PaperNest.iCloud.entitlements and are used only when
	Config/Signing.local.xcconfig turns iCloud on (see Config/Base.xcconfig).
	-->
</dict>
</plist>
